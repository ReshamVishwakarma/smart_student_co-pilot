# Smart Student Productivity Co-Pilot Environment Configuration Example
# Copy this file to .env before starting the application:
# cp .env.example .env

# Server Configuration (Note: Port 8001 is used by default to prevent collision with existing local services on 8000)
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
DEBUG=True

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Backend Service Info
PROJECT_NAME="Smart Student Productivity Co-Pilot Backend"
API_V1_PREFIX=/api/v1

# AI & LLM Provider (mock by default for local offline development)
LLM_PROVIDER=mock
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Privacy & Interruption Thresholds
DEFAULT_INTERRUPTION_THRESHOLD=70
PRIVACY_MODE=local_only
